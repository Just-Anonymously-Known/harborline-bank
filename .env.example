NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/harborline?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
APP_ORIGIN=http://localhost:3000

# Bootstrap the first administrator. Set a unique strong password before deployment.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_NAME=Harborline Demo Admin

# Gmail SMTP. Create an App Password in your Google Account and use it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
MAIL_FROM=Harborline <your-address@gmail.com>
